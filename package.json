{
  "name": "deepnest",
  "version": "1.5.6",
  "description": "Deep nesting for Laser and CNC",
  "private": true,
  "main": "main.js",
  "types": "index.d.ts",
  "license": "MIT",
  "funding": [
    {
      "type": "patreon",
      "url": "https://patreon.com/deepnest_next?utm_medium=clipboard_copy&utm_source=copyLink&utm_campaign=creatorshare_fan&utm_content=join_link"
    }
  ],
  "scripts": {
    "start": "electron .",
    "printenv": "cross-replace node -e \"console.log(process.env)\"",
    "test": "playwright test",
    "build": "tsc && electron-builder install-app-deps",
    "clean": "rmdir /s /q build dist >nul 2>&1|echo . >nul",
    "clean-all": "rmdir /s /q build dist node_modules bin >nul 2>&1|echo . >nul",
    "dist": "electron-builder build --publish never",
    "dist:dir": "electron-builder build --dir --publish never",
    "build-dist-signed": "electron-builder build --win --publish never -c.win.forceCodeSigning=true",
    "build-dist-linux": "electron-builder build --linux --publish never",
    "dist-all": "npm run clean-all && npm install && npm run build && npm run dist",
    "dist-all-signed": "npm run clean-all && npm install && npm run build && npm run build-dist-signed",
    "prepare": "husky || true",
    "precommit": "lint-staged",
    "postinstall": "electron-builder install-app-deps",
    "pw:codegen": "node helper_scripts/playwright_codegen.js"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{ts,html,css,scss,less,json}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  },
  "repository": "https://github.com/deepnest-next/deepnest",
  "keywords": [
    "Electron",
    "Nesting",
    "CNC",
    "Laser"
  ],
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.12.0",
    "cross-replace": "0.2.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "eslint": "^9.26.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  },
  "dependencies": {
    "@deepnest/calculate-nfp": "202503.13.155300",
    "@deepnest/svg-preprocessor": "0.2.0",
    "@electron/remote": "2.1.3",
    "axios": "1.16.0",
    "form-data": "4.0.6",
    "graceful-fs": "4.2.11",
    "marked": "17.0.1"
  },
  "files": [
    "main.js",
    "main/**/*",
    "index.d.ts",
    "node_modules",
    "package.json",
    "icon.icns",
    "icon.ico"
  ],
  "build": {
    "appId": "net.deepnest.app",
    "copyright": "2026 deepnest-next Community",
    "nodeGypRebuild": false,
    "files": [
      "**/*",
      "build/**/*.js",
      "!**/deepnest-v*",
      "!**/out",
      "!graphify-out",
      "!**/playwright-*",
      "!**/test*",
      "!**/*.ts",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/package-lock.json",
      "!test**",
      "!.readthedocs.yaml",
      "!**/._*",
      "!{examples,helper_scripts}",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.vscode,.husky,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "directories": {
      "app": ".",
      "output": "dist"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "icon.ico",
      "artifactName": "${name}-v${version}-win32-${arch}.${ext}",
      "signAndEditExecutable": true,
      "signExts": [
        ".node",
        ".exe",
        ".dll",
        ".sys",
        ".msi",
        ".appx",
        ".appxbundle"
      ],
      "signtoolOptions": {
        "sign": "./helper_scripts/sign_windows.js",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "icon.icns",
      "target": [
        "dmg",
        "pkg",
        "zip"
      ],
      "artifactName": "${name}-v${version}-darwin-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "zip",
        "deb",
        "rpm"
      ],
      "icon": "icons",
      "category": "Graphics",
      "maintainer": "deepnest-next Community <github@josef-froehle.de>",
      "artifactName": "${name}-v${version}-linux-${arch}.${ext}"
    }
  },
  "contributors": [
    {
      "name": "Josef Fröhle",
      "email": "github@josef-froehle.de"
    }
  ]
}
